# ── Variables ─────────────────────────────────────────────────────────────────
# After login, copy the token value and paste it in @token below
@base = http://localhost:8080
@token = PASTE_YOUR_TOKEN_HERE

# ── Auth ──────────────────────────────────────────────────────────────────────

### 1. Register
POST {{base}}/api/auth/register
Content-Type: application/json

{
  "name": "Yousif",
  "email": "yousif@test.com",
  "password": "123456",
  "phone": "+973 3300 0000"
}

### 2. Login  ← copy "token" from the response and paste into @token above
POST {{base}}/api/auth/login
Content-Type: application/json

{
  "email": "yousif@test.com",
  "password": "123456"
}

# ── Contacts ──────────────────────────────────────────────────────────────────

### 3. Create contact
POST {{base}}/api/contacts
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Ali Hassan",
  "phone": "+973 3300 1111",
  "email": "ali@test.com"
}

### 4. Get all contacts
GET {{base}}/api/contacts
Authorization: Bearer {{token}}

### 5. Delete contact (replace 1 with real id)
DELETE {{base}}/api/contacts/1
Authorization: Bearer {{token}}

# ── Lends ─────────────────────────────────────────────────────────────────────

### 6. Create lend (replace contactId with the id from step 3)
POST {{base}}/api/lends
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "contactId": 1,
  "amount": 100.000,
  "dueDate": "2027-06-01",
  "note": "Help for car repair"
}

### 7. Get all lends
GET {{base}}/api/lends
Authorization: Bearer {{token}}

### 8. Get lend by id (replace 1 with real id)
GET {{base}}/api/lends/1
Authorization: Bearer {{token}}

### 9. Accept lend (replace 1 with real id)
PATCH {{base}}/api/lends/1/accept
Authorization: Bearer {{token}}

### 10. Reject lend (replace 1 with real id)
PATCH {{base}}/api/lends/1/reject
Authorization: Bearer {{token}}

# ── Dashboard ─────────────────────────────────────────────────────────────────

### 11. Dashboard summary
GET {{base}}/api/dashboard/summary
Authorization: Bearer {{token}}

### 12. Due soon
GET {{base}}/api/dashboard/due-soon
Authorization: Bearer {{token}}
