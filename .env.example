# Salaf Backend Environment Variables
# Copy this file to .env and update the values for production

# JWT Configuration
JWT_SECRET=your-secure-256-bit-secret-key-change-in-production-must-be-at-least-256-bits
JWT_EXPIRATION_MS=86400000

# Encryption Key (optional, for additional data encryption)
ENCRYPTION_KEY=

# Logging Configuration
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_SECURITY=WARN

# Database Configuration (SQLite path is handled by Docker volume)
# DB_URL is set automatically in docker-compose.yml

# Server Configuration (handled by Docker)
# SERVER_PORT=8080